{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "Skeleton",
    "license": "MIT",
    "keywords": [
        "laravel",
        "framework"
    ],
    "require": {
        "php": "^8.3",
        "intervention/image-laravel": "4.0",
        "laravel/framework": "^13.8",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^3.0",
        "nwidart/laravel-modules": "^13.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "Modules\\MetaAdsImageGenerator\\": "Modules/MetaAdsImageGenerator/app/",
            "Modules\\MetaAdsImageGenerator\\Database\\Factories\\": "Modules/MetaAdsImageGenerator/database/factories/",
            "Modules\\MetaAdsImageGenerator\\Database\\Seeders\\": "Modules/MetaAdsImageGenerator/database/seeders/",
            "Modules\\KeywordResearch\\": "Modules/KeywordResearch/app/",
            "Modules\\KeywordResearch\\Database\\Factories\\": "Modules/KeywordResearch/database/factories/",
            "Modules\\KeywordResearch\\Database\\Seeders\\": "Modules/KeywordResearch/database/seeders/",
            "Modules\\ContentGenerator\\": "Modules/ContentGenerator/app/",
            "Modules\\ContentGenerator\\Database\\Factories\\": "Modules/ContentGenerator/database/factories/",
            "Modules\\ContentGenerator\\Database\\Seeders\\": "Modules/ContentGenerator/database/seeders/",
            "Modules\\SeoCluster\\": "Modules/SeoCluster/app/",
            "Modules\\SeoCluster\\Database\\Factories\\": "Modules/SeoCluster/database/factories/",
            "Modules\\SeoCluster\\Database\\Seeders\\": "Modules/SeoCluster/database/seeders/",
            "Modules\\AgentConnector\\": "Modules/AgentConnector/app/",
            "Modules\\AgentConnector\\Database\\Factories\\": "Modules/AgentConnector/database/factories/",
            "Modules\\AgentConnector\\Database\\Seeders\\": "Modules/AgentConnector/database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "wikimedia/composer-merge-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
